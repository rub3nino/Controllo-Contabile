# ===========================================
# QUADRA - Configurazione Ambiente
# ===========================================
# Copia questo file in .env e configura i valori
#
# Questo file funziona per:
# - Sviluppo locale (con o senza Docker)
# - Staging/Test su VPS
# - Produzione su VPS con Coolify

# -------------------------------------------
# ENVIRONMENT
# -------------------------------------------
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# -------------------------------------------
# SERVER
# -------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=1  # Aumentare in produzione
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000

# -------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------
# Sviluppo locale SENZA Docker:
# USE_SQLITE=true
# SQLITE_PATH=quadra.db

# Sviluppo con Docker o produzione:
DATABASE_URL=postgresql://quadra:quadra_dev@localhost:5432/quadra
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Credenziali PostgreSQL (usate da docker-compose)
POSTGRES_USER=quadra
POSTGRES_PASSWORD=quadra_dev
POSTGRES_DB=quadra

# -------------------------------------------
# REDIS
# -------------------------------------------
# Sviluppo SENZA Redis:
# USE_MEMORY_CACHE=true

# Con Redis:
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# STORAGE (Documenti)
# -------------------------------------------
# Opzioni: local, minio, s3
STORAGE_BACKEND=local

# Local (sviluppo)
STORAGE_LOCAL_PATH=./storage

# MinIO (staging/produzione su VPS)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=quadra-documents
MINIO_SECURE=false

# Per Docker:
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 (futuro, se servisse)
S3_REGION=eu-west-1

# -------------------------------------------
# MICROSOFT ENTRA ID (Azure AD)
# -------------------------------------------
# Crea un'app registration su Azure Portal:
# 1. Azure Portal → Microsoft Entra ID → App registrations
# 2. New registration
# 3. Redirect URI: http://localhost:8000/auth/callback (dev)
#                  https://yourdomain.com/auth/callback (prod)
# 4. API Permissions: User.Read (Microsoft Graph)
# 5. Certificates & secrets: New client secret

AZURE_CLIENT_ID=your-client-id-from-azure
AZURE_CLIENT_SECRET=your-client-secret-from-azure
AZURE_TENANT_ID=common  # o il tuo tenant specifico
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

# Per sviluppo SENZA Azure AD:
# AUTH_BYPASS=true
# AUTH_BYPASS_USER_EMAIL=dev@localhost

# -------------------------------------------
# JWT
# -------------------------------------------
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# SESSION
# -------------------------------------------
SESSION_COOKIE_NAME=quadra_session
SESSION_COOKIE_SECURE=false  # true in produzione HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=86400

# -------------------------------------------
# CELERY (Task asincroni)
# -------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------------------------------------------
# SUPER ADMIN
# -------------------------------------------
# Email degli utenti con accesso completo (comma-separated)
SUPER_ADMIN_EMAILS=ruben@yourdomain.com

# -------------------------------------------
# CORS
# -------------------------------------------
# Formato JSON array
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_MINUTE_PER_TENANT=1000

# -------------------------------------------
# LOGGING
# -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text  # text (dev) o json (prod)

# ===========================================
# PRODUZIONE (Coolify/VPS)
# ===========================================
# Decommentare e configurare per produzione

# Dominio (usato da Traefik per routing e SSL)
# DOMAIN=quadra.tuodominio.it

# HTTPS
# SESSION_COOKIE_SECURE=true
# AZURE_REDIRECT_URI=https://quadra.tuodominio.it/auth/callback

# Docker registry (per immagini build)
# DOCKER_REGISTRY=ghcr.io/tuousername
# VERSION=latest

# Database sicuro
# POSTGRES_PASSWORD=genera-password-sicura-qui
# JWT_SECRET_KEY=genera-secret-sicuro-qui
